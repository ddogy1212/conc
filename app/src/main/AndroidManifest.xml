<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="CONC 집중 스위치"
        android:icon="@drawable/ic_conc"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <receiver android:name=".FocusWidget" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.conc.focus.START"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/conc_widget"/>
        </receiver>

        <receiver android:name=".FocusTimerReceiver" android:exported="false"/>

        <service
            android:name=".FocusService"
            android:exported="true"
            android:label="CONC 앱 집중 제한"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/focus_accessibility"/>
        </service>
    </application>
</manifest>
